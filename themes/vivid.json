{
  "id": "vivid",
  "title": "Vivid",
  "description": "Colour-coded flowcharts: flat muted fills, dark labels and a teal accent.",
  "tags": ["colour", "flowchart", "light"],
  "order": 6,
  "node": {
    "radius": 6,
    "fill": { "type": "solid", "color": "#eef3f8" },
    "stroke": { "color": "#59718b", "width": 1.5 },
    "kinds": {
      "terminal": { "fill": { "type": "solid", "color": "#e6f1eb" }, "stroke": { "color": "#527864", "width": 1.5 } },
      "decision": { "fill": { "type": "solid", "color": "#faf0d9" }, "stroke": { "color": "#977436", "width": 1.5 } },
      "data": { "fill": { "type": "solid", "color": "#e8f0f8" }, "stroke": { "color": "#59718b", "width": 1.5 } },
      "document": { "fill": { "type": "solid", "color": "#efedf5" }, "stroke": { "color": "#75688d", "width": 1.5 } },
      "database": { "fill": { "type": "solid", "color": "#e8f0f8" }, "stroke": { "color": "#59718b", "width": 1.5 } },
      "note": { "fill": { "type": "solid", "color": "#faf0d9" }, "stroke": { "color": "#977436", "width": 1.2, "dash": [4, 3] } }
    },
    "accent": {
      "fill": { "type": "solid", "color": "#28695b" },
      "stroke": { "color": "#28695b", "width": 1.5 },
      "text": { "color": "#ffffff" }
    }
