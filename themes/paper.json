{
  "id": "paper",
  "title": "Paper",
  "description": "Editorial diagrams: fine paper grain, serif labels, warm ink and shallow relief.",
  "tags": ["print", "serif", "light", "textured"],
  "order": 5,
  "canvas": {
    "background": { "type": "solid", "color": "#faf8f2" },
    "texture": { "type": "noise", "opacity": 0.025, "scale": 0.8, "seed": 7 }
  },
  "fonts": {
    "title": { "family": "Source Serif 4", "size": 28, "weight": 600, "color": "#302d27" },
    "subtitle": { "color": "#625b50" },
    "node": { "family": "Source Serif 4", "size": 16, "weight": 400, "color": "#302d27" },
    "note": { "color": "#625b50" },
    "edge": { "weight": 400, "color": "#625b50" },
    "zone": { "color": "#625b50" },
    "footer": { "color": "#625b50" }
  },
  "node": {
    "radius": 2,
    "fill": { "type": "linear", "angle": 90, "stops": [[0, "#fffdf8"], [1, "#f2eee4"]] },
    "stroke": { "color": "#655d50", "width": 1.4 },
    "shadow": { "color": "#655d50", "opacity": 0.12, "blur": 2, "y": 2 },
    "kinds": {
      "terminal": { "fill": { "type": "solid", "color": "#eee9de" } },
      "decision": { "fill": { "type": "linear", "angle": 90, "stops": [[0, "#fffdf8"], [1, "#f2eee4"]] } },
      "data": { "fill": { "type": "linear", "angle": 90, "stops": [[0, "#fffdf8"], [1, "#f2eee4"]] } },
      "document": { "fill": { "type": "linear", "angle": 90, "stops": [[0, "#fffdf8"], [1, "#f2eee4"]] } },
      "database": { "fill": { "type": "linear", "angle": 90, "stops": [[0, "#fffdf8"], [1, "#f2eee4"]] } },
      "connector": { "fill": { "type": "solid", "color": "#fffdf8" } },
      "note": { "fill": { "type": "solid", "color": "#f3eedf" }, "stroke": { "color": "#82715a", "width": 1.2, "dash": [4, 3] } },
      "junction": { "fill": { "type": "solid", "color": "#655d50" }, "stroke": { "color": "#655d50", "width": 0 }, "shadow": null }
    },
    "accent": {
      "fill": { "type": "solid", "color": "#76523e" },
      "stroke": { "color": "#76523e", "width": 1.4 },
      "text": { "color": "#ffffff" }
    }
  },
  "edge": {
    "stroke": { "color": "#655d50", "width": 1.4 },
    "cornerRadius": 2,
    "label": { "fill": "#faf8f2" }
  },
  "zone": {
    "fill": { "type": "solid", "color": "#f0ece2" },
    "stroke": { "color": "#a59b8c", "width": 1, "dash": [6, 5] },
    "radius": 2
  }
}
