{
  "name": "dorpie",
  "version": "0.3.1",
  "description": "Local JSON diagrams with seven themes, SVG/PNG/ASCII output, saved revisions and OpenCode agent tools.",
  "type": "module",
  "license": "MIT",
  "author": "Krablante",
  "homepage": "https://github.com/Krablante/dorpie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krablante/dorpie.git"
  },
  "bugs": {
    "url": "https://github.com/Krablante/dorpie/issues"
  },
  "keywords": [
    "dorpie",
    "diagram",
    "flowchart",
    "svg",
    "png",
    "ascii",
    "themes",
    "llm",
    "agent",
    "cli",
    "opencode",
    "opencodez",
    "opencode-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dorpie": "bin/dorpie.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/opencode-plugin.js",
    "./library": "./src/library.js"
  },
  "files": [
    "bin",
    "src",
    "themes",
    "assets",
    "schema",
    "examples",
    "docs",
    "README*.md",
    "CHANGELOG*.md",
    "CONTRIBUTING*.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "metrics": "node scripts/build-metrics.mjs",
    "gallery": "node scripts/gallery.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "elkjs": "^0.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "opentype.js": "^1.3.4",
    "typescript": "^5.7.0"
  }
}
