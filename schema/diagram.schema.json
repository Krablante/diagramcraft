{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Krablante/dorpie/schema/diagram.schema.json",
  "title": "Dorpie diagram spec",
  "description": "A single editable JSON document that renders to SVG, PNG and ASCII.",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "version": { "enum": [1, null], "description": "Spec version. Defaults to 1." },
    "title": { "type": ["string", "null"], "description": "Diagram title rendered above the flow." },
    "subtitle": { "type": ["string", "null"], "description": "Smaller line under the title." },
    "footer": { "type": ["string", "null"], "description": "Small line at the bottom of the canvas." },
    "theme": { "type": ["string", "null"], "default": "classic", "description": "Built-in theme id or a path to a theme JSON file." },
    "direction": { "type": ["string", "null"], "pattern": "^(?:[Tt][Bb]|[Ll][Rr]|[Rr][Ll]|[Bb][Tt])$", "default": "TB", "description": "Flow direction, case-insensitive: top-to-bottom, left-to-right, right-to-left, bottom-to-top." },
    "layout": {
      "type": ["object", "null"],
      "properties": {
        "nodeGap": { "type": "number", "exclusiveMinimum": 0, "description": "Gap between nodes in the same layer." },
        "rankGap": { "type": "number", "exclusiveMinimum": 0, "description": "Gap between layers." },
        "edgeGap": { "type": "number", "exclusiveMinimum": 0, "description": "Gap between edges and nodes." }
      },
      "additionalProperties": false
    },
    "style": { "type": ["object", "null"], "description": "Deep overrides merged over the resolved theme (colours, fonts, spacing)." },
    "output": {
      "type": ["object", "null"],
      "properties": {
        "formats": { "type": ["array", "null"], "minItems": 1, "items": { "enum": ["svg", "png", "ascii"] } },
        "scale": { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "PNG scale factor." },
        "transparent": { "type": "boolean", "description": "Drop the canvas background." },
        "charset": { "enum": ["unicode", "ascii", null], "description": "ASCII output character set." }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "Unique id referenced by edges and groups." },
          "label": { "type": ["string", "null"], "description": "Node text. Defaults to the id; junction nodes have no label." },
          "kind": {
            "enum": ["terminal", "process", "decision", "data", "document", "database", "connector", "note", "junction", null],
            "default": "process"
          },
          "note": { "type": ["string", "null"], "description": "Small second line inside the node." },
          "accent": { "type": "boolean", "description": "Highlight the node with the theme accent." },
          "color": { "type": ["string", "null"], "description": "Solid fill colour for this node." },
          "maxWidth": { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "Wrap text at this width." },
          "width": { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "Fixed node width." },
          "height": { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "Fixed node height." }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "id": { "type": ["string", "null"] },
          "from": { "type": "string", "description": "Source node id." },
          "to": { "type": "string", "description": "Target node id." },
          "label": { "type": ["string", "null"], "description": "Short label, usually yes/no." },
          "kind": { "enum": ["solid", "dashed", "dotted", null], "default": "solid" },
          "arrow": { "enum": ["end", "both", "none", null], "default": "end" },
          "color": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "groups": {
      "type": ["array", "null"],
      "description": "Visual zones around member nodes. Groups do not constrain layout.",
      "items": {
        "type": "object",
        "required": ["nodes"],
        "properties": {
          "id": { "type": ["string", "null"] },
          "label": { "type": ["string", "null"], "description": "Zone label, placed in the left gutter." },
          "nodes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "color": { "type": ["string", "null"], "description": "Zone fill colour override." }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
